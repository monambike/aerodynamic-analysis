
  /* ANIMATION KEYFRAMES */
  @keyframes changebrightness {
    from {
      filter: brightness(0);
    }
    to {
      filter: brightness(1);
    }
  }
  
  @keyframes changeopacity {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes glare {
    from {
      left: 0;
      opacity: 0.3;
    }
    to {
      left: 100%;
      opacity: 0.6;
    }
  }