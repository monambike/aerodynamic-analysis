/*-- scss:rules --*/

.reveal{
  background:
    linear-gradient(
      rgba($black, 0.95),
      rgba($black, 0.95)
    ),
    url("../../../../../resources/images/background-airplane-pattern-gray.jpg");
  background-repeat: repeat;
  background-size: contain;
  background-position: center;
  color: $black;

  /* First Slide */
  .title {
    background-color: rgba($black, 1);
    border-radius: 2px;
    padding: 20px 0px;
    color: $purple_3;
  }
  .subtitle {
    color: $purple_1;
    opacity: 0;
  }
  .slides > section:first-child{
    background-color: rgba($black, 0.95);
    border-left: 6px solid $purple_2;
    border-bottom-right-radius: 20px;
    box-shadow: 5px 5px 0px $purple_1;
    padding: 20px;
  }
  
  section.level2 {
    background-color: $white;
    ul {
      padding: 20px;
    }
  }
  
  .title-slide {
    background-color: $purple_2;
    color: $white;
  }
  
  h1 {
    text-shadow: 5px 5px $black;
    text-transform: uppercase;
  }
  
  h2 {
    background-color: $purple_2;
    color: $white;
    text-shadow: 5px 5px $purple_3;
    padding: 20px;
  }
  
  
  .footer-logo-ufv {
    background-color: white;
    border-radius: 2px;
    display: flex;
    margin-left: auto;
    margin-right: 50px;
    padding: 10px;
    vertical-align: middle;
    box-shadow: 5px 5px 0px $black;
  }

  h2 {
    position: relative;
    overflow: hidden;
  }

  section h2::after {
    background: rgba($white, 0.3);
    content: "";
    height: 100%;
    left: -20%;
    position: absolute;
    top: 0;
    transform: skewX(-20deg);
    width: 80px;
  }

  section {
    &.present .subtitle {
      animation: changeopacity 600ms ease-in forwards;
      animation-delay: 0.5s;
    }
    &.past .subtitle,
    &.future .subtitle {
      animation: none;
      opacity: 0;
    }

    /* Playing animation for current slide */
    &.present h2::after {
      animation: glare 800ms ease-in;
    }
    /* Removing animation state for every slide */
    &.past h2::after,
    &.future h2::after {
      animation: none;
      content: none;
    }
  }
  
  section.present li {
    opacity: 0;
    animation: fadeup 600ms ease forwards;
  }
  section.past li,
  section.future li {
    animation: none;
    opacity: 0;
  }
  
  
  @for $i from 1 through 20 {
  section.present li:nth-child(#{$i}) {
      animation-delay: $i * 0.2s;
    }
  }

  @keyframes glare {
    from {
      left: 0;
      opacity: 0.3;
    }
    to {
      left: 100%;
      opacity: 0.6;
    }
  }
  
  @keyframes changeopacity {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}
