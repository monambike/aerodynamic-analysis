switch(
input$filter_metric,
"cl_alpha" =
plot_airfoil_cl_alpha(df_asa),
"cd_alpha" =
plot_airfoil_cd_alpha(df_asa),
"clcd_alpha" =
plot_airfoil_clcd_alpha(df_asa)
)
})
