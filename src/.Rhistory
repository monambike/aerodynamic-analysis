library(here)
library(plotly)
library(tidyverse)
source(here("R/aircraft_data.R"))
df_asa <- aircraft_data$airfoil_wing %>% mutate(Perfil = "Asa")
df_eh  <- aircraft_data$airfoil_horizontal_stabilizer %>% mutate(Perfil = "Emp. Horizontal")
df_ev  <- aircraft_data$airfoil_vertical_stabilizer %>% mutate(Perfil = "Emp. Vertical")
# Juntando tudo num único Dataframe 2D
df_2d <- bind_rows(df_asa, df_eh, df_ev) %>%
rename_with(~str_trim(.)) %>% # Remove espaços em branco dos nomes das colunas
