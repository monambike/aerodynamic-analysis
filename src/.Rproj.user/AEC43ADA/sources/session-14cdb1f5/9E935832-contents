library(here)
library(readr)

DATA_FOLDER = here("data")

get_data_file <- function(file_name) {
  result <- read_csv(file.path(DATA_FOLDER, file_name), show_col_types = FALSE)
  return(result)
}

aeronave_dados <- list(
  perfil_asa = get_data_file("airfoil-wing.csv"),
  perfil_empenagem_horizontal = get_data_file("airfoil-horizontal-stabilizer.csv"),
  perfil_empenagem_vertical = get_data_file("airfoil-vertical-stabilizer.csv"),
  aeronave = get_data_file("aircraft.csv")
)
