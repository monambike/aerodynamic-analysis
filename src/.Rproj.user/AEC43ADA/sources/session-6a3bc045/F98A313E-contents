/*-- scss:rules --*/

body {
  background:
    linear-gradient(
      rgba(#111111, 0.95),
      rgba(#111111, 0.95)
    ),
    url("#{$base-path-images}/background-airplane-pattern-gray.jpg");
  background-position: center;
  background-repeat: repeat;
  background-size: contain;
}

.card-body.html-fill-item.html-fill-container {
  .airfoil-filters {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
  }
  
  img.navbar-logo.light-content.d-inline-block {
    padding: 5px;

    background-color: white;
    border-radius: 2px;
    box-shadow: inset 2px 2px 4px 1px;
  }
}
