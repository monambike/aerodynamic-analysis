plot_cd_cl <- function(df) {
  ggplot(df, aes(x = CD, y = CL)) +
    geom_point() +
    geom_path() +
    theme_classic() +
    labs(
      title = "CL x CD",
      x = "CD",
      y = "CL"
    )
}


