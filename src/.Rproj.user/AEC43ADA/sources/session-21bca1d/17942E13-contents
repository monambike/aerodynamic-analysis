library(here)
library(readr)


DATA_FOLDER = here("../data")

AIRFOIL_WING_FILE_PATH = "airfoil-wing.csv"
AIRFOIL_HORIZONTAL_STABILIZER_FILE_PATH = "airfoil-horizontal-stabilizer.csv"
AIRFOIL_VERTICAL_STABILIZER_FILE_PATH = "airfoil-vertical-stabilizer.csv"
AIRCRAFT_FILE_PATH = "aircraft.csv"


AIRFOIL_WING_COORDINATES_FILE_PATH = "airfoil-wing-coordinates.csv"
AIRFOIL_HORIZONTAL_STABILIZER_COORDINATES_FILE_PATH = "airfoil-horizontal-stabilizer-coordinates.csv"
AIRFOIL_VERTICAL_STABILIZER_COORDINATES_FILE_PATH = "airfoil-vertical-stabilizer-coordinates.csv"


get_data_file_path <- function(file_name){
  return(file.path(DATA_FOLDER, file_name))
}

get_data_file <- function(file_name) {
  result <- read_csv(get_data_file_path(file_name), show_col_types = FALSE)
  return(result)
}

aircraft_dataframe <- list(
  airfoil_wing = get_data_file(AIRFOIL_WING_FILE_PATH),
  airfoil_horizontal_stabilizer = get_data_file(AIRFOIL_HORIZONTAL_STABILIZER_FILE_PATH),
  airfoil_vertical_stabilizer = get_data_file(AIRFOIL_VERTICAL_STABILIZER_FILE_PATH),
  aircraft = get_data_file(AIRCRAFT_FILE_PATH)
)
