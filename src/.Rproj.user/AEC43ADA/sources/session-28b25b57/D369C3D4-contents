# Comparar Perfis

```{r}
#| content: sidebar
#| title: Configurações

selectInput(
  "input_metric",
  "Métrica:",
  choices = c(
    "Cd vs Cl" = "cd_cl",
    "Cl vs Alfa" = "cl_alpha",
    "Cd vs Alfa" = "cd_alpha"
  )
)

selectInput(
  "cmb_axis_x",
  "Eixo X:",
  choices = c(
    "Alfa (Ângulo de Ataque)" = "alpha",
    "Velocidade" = "speed"
  )
)

checkboxGroupInput( 
  "chkgrp_profiles", 
  "Visualizar Perfis:", 
  c( 
    "Asa" = "profile_wing", 
    "Empenagem (Horizontal)" = "profile_stabilizer_horizontal", 
    "Empenagem (Vertical)" = "profile_stabilizer_vertical" 
  ) 
)
```

## Row {height=50%}

### Chart 1

```{r}
renderPlot({
  if (input$cmbSection == "profile_wing") {
    plot(dados_asa$x, dados_asa$y)
  }

  if (input$cmbSection == "profile_stabilizer_horizontal") {
    plot(dados_horizontal$x, dados_horizontal$y)
  }

  if (input$cmbSection == "profile_stabilizer_vertical") {
    plot(dados_vertical$x, dados_vertical$y)
  }
})
```

