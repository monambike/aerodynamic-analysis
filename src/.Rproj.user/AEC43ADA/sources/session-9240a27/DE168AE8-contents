/*-- scss:rules --*/

.reveal{
  background: 
    linear-gradient(
      rgba($black, 0.95),
      rgba($black, 0.95)
    );
  &:not(:has(.present.first-slide)) {
    background:
      linear-gradient(
        rgba($black, 0.95),
        rgba($black, 0.95)
      ),
      url("#{$base-path-images}/background-airplane-pattern-gray.jpg");
    background-position: center;
    background-repeat: repeat;
    background-size: contain;
  }
  filter: brightness(0);
  color: $black;
  
  animation: changebrightness 1200ms ease-out forwards;
  animation-delay: 1.5s;


  /* || DIVISORY LAYOUTS */
  .first-slide {
    background: none;
  }
  .title-slide {
    background-color: $purple2;
    color: $white;
  }

  section.level2 {
    background-color: $white;

    ul {
      padding: 20px;
    }
  }

  .footer-logo-ufv {
    display: flex;
    vertical-align: middle;
    margin-left: auto;
    margin-right: 50px;
    padding: 10px;

    background-color: $white;
    border-radius: 2px;
    box-shadow: 5px 5px 0px $black;
  }


  /* || TEXT AND IMAGE ELEMENTS */
  h1 {
    text-transform: uppercase;
    text-shadow: 5px 5px $black;
  }

  h2 {
    position: relative;
    padding: 20px;

    overflow: hidden;
    background-color: $purple2;
    color: $white;

    text-shadow: 5px 5px $purple3;


    &::after {
      content: "";

      position: absolute;
      top: 0;
      left: -20%;
      height: 100%;
      width: 80px;
      transform: skewX(-20deg);

      background: rgba($white, 0.3);
    }
  }

  li {
    /* <a href="https://www.flaticon.com/free-icons/up-arrow" title="up arrow icons">Up arrow icons created by SumberRejeki - Flaticon</a> */
    list-style-image: url("/#{$base-path-images}/icon-up-arrow.png");
    padding: 10px 20px;
  }

  .present img {
    padding: 10px;

    box-shadow: 5px 5x 0px $black;
    opacity: 0;

    animation: changeopacity $animation-normal ease-in forwards;
    animation-delay: 1s;
  }
  .past img,
  .future img {
    opacity: 0;

    animation: none;
  }
  .caption {
    font-style: italic;

    padding: 10px;

    color: $gray;
  }


  /* || SPECIFIC SLIDE CSS */
  /* First Slide - Presentation Start */
  .title {
    padding: 20px 0px;

    background-color: rgba($black, 1);
    color: $purple3;

    border-radius: 2px;
  }

  .subtitle {
    color: $purple1;
    opacity: 0;
  }

  .slides > section:first-child{
    background-color: rgba($black, 0.95);
    border-left: 6px solid $purple2;
    border-bottom-right-radius: 20px;
    box-shadow: 5px 5px 0px $purple1;
    padding: 20px;
  }

  .slide-background video {
    filter: blur(10px) brightness(0.5) !important;
  }


  /* || ANIMATIONS */
  section {
    /* Opacity animation in subtitles */
    &.present .subtitle {
      animation: changeopacity $animation-normal ease-in forwards;
      animation-delay: $delay-normal;
    }
    &.past .subtitle,
    &.future .subtitle {
      opacity: 0;
      animation: none;
    }

    /* Glares animation in H2 backgrounds */
    &.present h2::after {
      animation: glare $animation-normal ease-in;
    }
    &.past h2::after,
    &.future h2::after {
      content: none;
      animation: none;
    }
    
    /* Fade up animation in items from list */
    section.present li {
      opacity: 0;
      animation: fadeup $animation-normal ease forwards;
    }
    section.past li,
    section.future li {
      opacity: 0;
      animation: none;
    }
    /* Making every item in a list animate one after other within a delay */
    @for $i from 1 through 20 {
    section.present li:nth-child(#{$i}) {
        animation-delay: $i * 0.2s;
      }
    }
  }
}
