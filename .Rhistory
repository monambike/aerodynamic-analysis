library(readr)
ASA <- read_csv("C:/Users/Admin/OneDrive/Área de Trabalho/Dados/ASA.txt",
skip = 8)
library(readr)
Emenagem_Horiz <- read_csv("C:/Users/Admin/OneDrive/Área de Trabalho/Dados/Emenagem Horiz.csv",
skip = 8)
View(Emenagem_Horiz)
library(tidyverse)
library(dbplyr)
library(ggplot2)
dados < Emenagem_Horiz
library(tidyverse)
library(dbplyr)
library(ggplot2)
dados <- Emenagem_Horiz
glimpse(dados)
dados <- dados %>%
mutate(Eficiencia = CL / CD)
# Filtrando a tabela para mostrar apenas a linha onde a eficiência é máxima
ponto_de_projeto <- dados %>%
filter(Eficiencia == max(Eficiencia, na.rm = TRUE))
# Exibindo o resultado no console
print(ponto_de_projeto)
plot_sustentacao <- ggplot(dados, aes(x = alpha, y = CL)) +
geom_line(color = "darkblue", size = 1) +
geom_point(color = "black") +
labs(
title = "Curva de Sustentação",
x = expression(alpha~"(graus)"),
y = expression(C_L)
) +
theme_minimal()
# Plotando a Polar de Arrasto (CL x CD)
plot_polar_arrasto <- ggplot(dados, aes(x = CL, y = CD)) +
geom_line(color = "firebrick", size = 1) +
labs(
title = "Polar de Arrasto",
x = expression(C_D),
y = expression(C_L)
) +
theme_minimal()
# Exibir os gráficos
print(plot_sustentacao)
print(plot_polar_arrasto)
